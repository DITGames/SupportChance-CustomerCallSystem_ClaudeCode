<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SupportChance_CustomerCallSystem_ClaudeCode</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同梱のサンプル音声を、exeと同じフォルダの Assets\Sounds にコピーする。
         (SDKの既定グロブで既に None として拾われているため Include ではなく
          Update でメタデータだけ追加する。Include だと重複項目エラーになる) -->
    <None Update="Assets\Sounds\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>